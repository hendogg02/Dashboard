<?xml version="1.0" encoding="UTF-8"?><abs contexttype="opengear" gridaspect="false" gridheight="203" gridwidth="1304" keepalive="false" style="bg#000000;" touch="true" virtualheight="203" virtualwidth="1304">
    <meta>
        <params>
            <param access="1" maxlength="0" name="TV Tab/Group" oid="cfg.tv.group" precision="-1" type="STRING_ARRAY" widget="text">
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
            </param>
            <param access="1" maxlength="0" name="TV Label" oid="cfg.tv.label" precision="-1" type="STRING_ARRAY" widget="text">
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
            </param>
            <param access="1" maxlength="0" name="TV IP Address" oid="cfg.tv.ip" precision="-1" type="STRING_ARRAY" widget="text">
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
                <value/>
            </param>
            <param access="1" maxlength="0" name="TV Row" oid="cfg.tv.row" precision="-1" type="STRING_ARRAY" widget="text">
                <value/>
                <value/>
                <value>top</value>
                <value>top</value>
                <value>bottom</value>
                <value>bottom</value>
                <value>bottom</value>
                <value>bottom</value>
            </param>
            <param access="1" maxlength="0" name="Rename Tab Input" oid="cfg.rename.input" type="STRING_ARRAY" widget="text">
                <value/>
            </param>
            <param access="1" maxlength="0" name="New Tab Name" oid="cfg.newtab.name" type="STRING" value="" widget="text"/>
            <param access="1" maxlength="0" name="Theme: Background (Sleek Black)" oid="cfg.theme.bg" precision="-1" type="STRING_ARRAY" widget="text">
                <value>C7C6C6</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Card Background (Sleek Black)" oid="cfg.theme.card" type="STRING_ARRAY" widget="text">
                <value>000000</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Button (Truss Gray)" oid="cfg.theme.button" precision="-1" type="STRING_ARRAY" widget="text">
                <value>111111</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Button Text (Sleek Black)" oid="cfg.theme.buttontext" precision="-1" type="STRING_ARRAY" widget="text">
                <value>FFFFFF</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Text (Haze Gray)" oid="cfg.theme.text" type="STRING_ARRAY" widget="text">
                <value>F2F2F2</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Accent (White)" oid="cfg.theme.accent" precision="-1" type="STRING_ARRAY" widget="text">
                <value>C7C6C6</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Accent Text (Sleek Black)" oid="cfg.theme.accenttext" precision="-1" type="STRING_ARRAY" widget="text">
                <value>000000</value>
            </param>
            <param access="1" maxlength="0" name="Theme: Logo URL" oid="cfg.theme.logo" type="STRING_ARRAY" widget="text">
                <value/>
            </param>
            <param access="1" maxlength="0" name="sony.port" oid="sony.port" type="STRING" value="20060" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.toggle" oid="sony.power.toggle" type="STRING" value="2a 53 43 54 50 4f 57 23 23 23 23 23 23 23 23 23 23 23 23 23 23 23 23 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.on" oid="sony.power.on" type="STRING" value="2a 53 43 50 4f 57 52 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 31 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.off" oid="sony.power.off" type="STRING" value="2A 53 43 50 4F 57 52 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.get" oid="sony.power.get" type="STRING" value="2A 53 45 50 4F 57 52 23 23 23 23 23 23 23 23 23 23 23 23 23 23 23 23 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.state.on" oid="sony.power.state.on" type="STRING" value="2A 53 41 50 4F 57 52 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 31 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.state.off" oid="sony.power.state.off" type="STRING" value="2A 53 41 50 4F 57 52 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.power.state.error" oid="sony.power.state.error" type="STRING" value="2A 53 41 50 4F 57 52 46 46 46 46 46 46 46 46 46 46 46 46 46 46 46 46 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.hdmi_1" oid="sony.hdmi_1" type="STRING" value="2A 53 43 49 4E 50 54 30 30 30 30 30 30 30 31 30 30 30 30 30 30 30 31 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.hdmi_2" oid="sony.hdmi_2" type="STRING" value="2A 53 43 49 4E 50 54 30 30 30 30 30 30 30 31 30 30 30 30 30 30 30 32 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.hdmi_3" oid="sony.hdmi_3" type="STRING" value="2A 53 43 49 4E 50 54 30 30 30 30 30 30 30 31 30 30 30 30 30 30 30 33 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.input.get" oid="sony.input.get" type="STRING" value="2A 53 45 49 4E 50 54 23 23 23 23 23 23 23 23 23 23 23 23 23 23 23 23 0a" widget="default"/>
            <param access="1" maxlength="0" name="sony.input.state.hdmi_1" oid="sony.input.state.hdmi_1" type="STRING" value="2A 53 41 49 4E 50 54 30 30 30 30 30 30 30 31 30 30 30 30 30 30 30 31 0A" widget="default"/>
            <param access="1" maxlength="0" name="sony.input.state.hdmi_2" oid="sony.input.state.hdmi_2" type="STRING" value="2A 53 41 49 4E 50 54 30 30 30 30 30 30 30 31 30 30 30 30 30 30 30 32 0A" widget="default"/>
            <param access="1" maxlength="0" name="sony.input.state.hdmi_3" oid="sony.input.state.hdmi_3" type="STRING" value="2A 53 41 49 4E 50 54 30 30 30 30 30 30 30 31 30 30 30 30 30 30 30 33 0A" widget="default"/>
        </params>
        <api><![CDATA[
var MAX_TVS = 24;

// --- Theme: colors and logo are stored as params so they're editable from
//     the Setup tab. Every button/page style is built from these at rebuild
//     time rather than a static <style> tag, since a static tag can't be
//     changed at runtime the way generated inline styles can.

function themeVal(oid, fallback) {
   return params.getValue(oid, 0) || fallback;
}
function themeBg() { return themeVal('cfg.theme.bg', '000000'); }
function themeCard() { return themeVal('cfg.theme.card', '000000'); }
function themeButton() { return themeVal('cfg.theme.button', 'C7C6C6'); }
function themeButtonText() { return themeVal('cfg.theme.buttontext', '000000'); }
function themeText() { return themeVal('cfg.theme.text', 'F2F2F2'); }
function themeAccent() { return themeVal('cfg.theme.accent', 'FFFFFF'); }
function themeAccentText() { return themeVal('cfg.theme.accenttext', '000000'); }
function themeLogo() { return params.getValue('cfg.theme.logo', 0) || ''; }

function cmdBtnStyle() {
   return 'bg#' + themeButton() + ';fg#' + themeButtonText() + ';bdr:none;txt-align:center;';
}
function accentBtnStyle() {
   return 'bg#' + themeAccent() + ';fg#' + themeAccentText() + ';bdr:none;txt-align:center;';
}
function pageBgStyle() {
   return 'bg#' + themeCard() + ';';
}
function labelStyle() {
   return 'font:bold;fg#' + themeText() + ';';
}

// Small logo overlay tucked in a page's bottom-right corner; a no-op string
// when no logo URL is configured. Appended after a page's main content so
// it paints on top rather than getting covered by it.
// Lives as a persistent root-level element (like listenerHost/renamePopup)
// rather than embedded in any one page, so it's visible no matter which tab
// is active and never competes for space with a page's own buttons - every
// page's own layout already fills edge-to-edge with no natural margin to
// tuck a corner overlay into, except the tab strip itself at the bottom of
// the panel (below the 170px-tall page area, above the panel's 203px total).
function buildLogoXml() {
   var logo = themeLogo();
   if (!logo) return '';
   return '<label left="0" top="0" width="64" height="26" name="" style="bg-u:' + escapeXmlAttr(logo) + ';bg-fill:fit;bdr:none;"/>';
}

function rebuildLogo() {
   ogscript.setXML('logoHost', buildLogoXml());
}

function escapeXmlAttr(s) {
   return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function escapeXmlText(s) {
   return String(s == null ? '' : s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function jsStr(s) {
   return "'" + String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'") + "'";
}

function taskTag(code) {
   return '<task tasktype="ogscript">' + escapeXmlText(code) + '</task>';
}

function sanitizeId(s) {
   return String(s).replace(/[^A-Za-z0-9_-]/g, '_');
}

function tabIdFor(groupName) {
   return 'tab_' + sanitizeId(groupName);
}

function settingsIdFor(groupName) {
   return 'settings_' + sanitizeId(groupName);
}

function mainIdFor(groupName) {
   return 'main_' + sanitizeId(groupName);
}

// A full rebuild of 'mainTabs' replaces every page, including whichever one
// is currently selected, and doesn't remember the selection across that
// swap - it snaps back to the first tab. Theme edits happen on the Setup
// tab and trigger exactly this kind of full rebuild (colors are baked into
// every generated page, not live-bindable), so re-reveal it afterward the
// same way a renamed/edited group tab is kept open.
function stayOnSetupTab() {
   ogscript.asyncExec(function() {
      ogscript.reveal('setupTab');
   }, 500);
}

// --- Config: read the TV list out of the cfg.tv.* parallel arrays. A row
//     is "used" once any of its three fields is non-blank, so a brand new
//     tab can exist with a placeholder TV before an IP is ever typed in. ---

function isRowUsed(i) {
   return !!(params.getValue('cfg.tv.group', i) || params.getValue('cfg.tv.label', i) || params.getValue('cfg.tv.ip', i));
}

function findFreeSlot() {
   for (var i = 0; i < MAX_TVS; i++) {
      if (!isRowUsed(i)) return i;
   }
   return -1;
}

function getTvRow(i) {
   return params.getValue('cfg.tv.row', i) === 'bottom' ? 'bottom' : 'top';
}

function getConfiguredTvs() {
   var list = [];
   for (var i = 0; i < MAX_TVS; i++) {
      if (!isRowUsed(i)) continue;
      list.push({
         index: i,
         group: params.getValue('cfg.tv.group', i) || 'Ungrouped',
         label: params.getValue('cfg.tv.label', i) || ('TV ' + (i + 1)),
         ip: params.getValue('cfg.tv.ip', i) || '',
         row: getTvRow(i),
         btn: 'tv' + i
      });
   }
   return list;
}

function getGroups(tvs) {
   var groups = [];
   for (var i = 0; i < tvs.length; i++) {
      if (groups.indexOf(tvs[i].group) === -1) groups.push(tvs[i].group);
   }
   return groups;
}

function tvsInGroup(groupName) {
   var all = getConfiguredTvs();
   var out = [];
   for (var i = 0; i < all.length; i++) {
      if (all[i].group === groupName) out.push(all[i]);
   }
   return out;
}

// --- Sony commands ---

function sendPower(ip, cmdOid) {
   if (!ip) return;
   rosstalk.sendAsBytes(ip, params.getValue('sony.port', 0), params.getValue(cmdOid, 0), null);
}

function toggleTv(idx) {
   sendPower(params.getValue('cfg.tv.ip', idx), 'sony.power.toggle');
   ogscript.asyncExec(function() { pollTv(idx); }, 1500);
}

function selectHdmi(idx, hdmiNum) {
   sendPower(params.getValue('cfg.tv.ip', idx), 'sony.hdmi_' + hdmiNum);
   ogscript.asyncExec(function() { pollTv(idx); }, 1500);
}

function toggleGroup(groupName) {
   var tvs = tvsInGroup(groupName);
   for (var i = 0; i < tvs.length; i++) sendPower(tvs[i].ip, 'sony.power.toggle');
   ogscript.asyncExec(pollAllTvs, 1500);
}

function powerOnGroup(groupName) {
   var tvs = tvsInGroup(groupName);
   for (var i = 0; i < tvs.length; i++) sendPower(tvs[i].ip, 'sony.power.on');
   ogscript.asyncExec(pollAllTvs, 1500);
}

function powerOffGroup(groupName) {
   var tvs = tvsInGroup(groupName);
   for (var i = 0; i < tvs.length; i++) sendPower(tvs[i].ip, 'sony.power.off');
   ogscript.asyncExec(pollAllTvs, 1500);
}

function toggleAll() {
   var tvs = getConfiguredTvs();
   for (var i = 0; i < tvs.length; i++) sendPower(tvs[i].ip, 'sony.power.toggle');
   ogscript.asyncExec(pollAllTvs, 1500);
}

function powerOnAll() {
   var tvs = getConfiguredTvs();
   for (var i = 0; i < tvs.length; i++) sendPower(tvs[i].ip, 'sony.power.on');
   ogscript.asyncExec(pollAllTvs, 1500);
}

function powerOffAll() {
   var tvs = getConfiguredTvs();
   for (var i = 0; i < tvs.length; i++) sendPower(tvs[i].ip, 'sony.power.off');
   ogscript.asyncExec(pollAllTvs, 1500);
}

// --- Config editing: each tab's own Settings drawer calls these. ---

function incrementIp(ip) {
   var parts = String(ip).split('.');
   if (parts.length !== 4) return '';
   var last = parseInt(parts[3], 10);
   if (isNaN(last)) return '';
   parts[3] = String((last + 1) % 256);
   return parts.join('.');
}

function addTvToGroup(groupName) {
   var idx = findFreeSlot();
   if (idx === -1) return;
   var existing = tvsInGroup(groupName);
   var count = existing.length;
   var newIp = '';
   if (count > 0) {
      var lastIp = existing[count - 1].ip;
      if (lastIp) newIp = incrementIp(lastIp);
   }
   params.setValue('cfg.tv.group', idx, groupName);
   params.setValue('cfg.tv.label', idx, groupName + ' ' + (count + 1));
   params.setValue('cfg.tv.ip', idx, newIp);
   updateGroupTab(groupName);
}

function toggleTvRow(idx) {
   var groupName = params.getValue('cfg.tv.group', idx);
   params.setValue('cfg.tv.row', idx, getTvRow(idx) === 'bottom' ? 'top' : 'bottom');
   updateGroupTab(groupName);
}

function removeTv(idx) {
   var groupName = params.getValue('cfg.tv.group', idx);
   params.setValue('cfg.tv.group', idx, '');
   params.setValue('cfg.tv.label', idx, '');
   params.setValue('cfg.tv.ip', idx, '');
   updateGroupTab(groupName);
}

// The rename popup is declared once, at the root of the document (outside
// mainTabs, alongside listenerHost), rather than embedded per-tab - the
// same pattern PDU Ctrl.grid uses for its confirm dialog. A popup anchored
// inside a deeply-nested table cell opens from wherever that cell happens
// to render, which pushed it off-canvas; a fixed-position root-level popup
// opens from a stable, controlled spot instead.
function openRenamePopup(groupName) {
   ogscript.putObject('pendingRenameGroup', groupName);
   ogscript.reveal('renamePopup');
}

function renameGroup() {
   var oldName = ogscript.getObject('pendingRenameGroup');
   var newName = params.getValue('cfg.rename.input', 0);
   ogscript.hide('renamePopup');
   if (!oldName || !newName || newName === oldName) return;
   var tvs = tvsInGroup(oldName);
   if (tvs.length === 0) return;
   for (var i = 0; i < tvs.length; i++) {
      params.setValue('cfg.tv.group', tvs[i].index, newName);
   }
   params.setValue('cfg.rename.input', 0, '');
   rebuildFromConfig(newName);
}

function deleteGroup(groupName) {
   var tvs = tvsInGroup(groupName);
   for (var i = 0; i < tvs.length; i++) {
      params.setValue('cfg.tv.group', tvs[i].index, '');
      params.setValue('cfg.tv.label', tvs[i].index, '');
      params.setValue('cfg.tv.ip', tvs[i].index, '');
   }
   rebuildFromConfig();
}

function createTab() {
   var name = params.getValue('cfg.newtab.name', 0);
   if (!name) return;
   var idx = findFreeSlot();
   if (idx === -1) return;
   params.setValue('cfg.tv.group', idx, name);
   params.setValue('cfg.tv.label', idx, name + ' 1');
   params.setValue('cfg.tv.ip', idx, '');
   params.setValue('cfg.newtab.name', 0, '');
   rebuildFromConfig(name);
}

// --- Power-state polling / button coloring ---

// A live capture off a real TV's connection showed it proactively pushes
// unsolicited status lines the moment a client connects - POWR, INPT,
// AMUT, VOLU, PMUT - each framed as "*SN<NAME><16-digit payload>", i.e.
// "*SN" (Notify), not the "*SA" (Answer-to-query) prefix the params were
// built around. Match on each field's payload regardless of the *SN/*SA
// framing, and ignore any notify line that doesn't carry a field we care
// about (AMUT/VOLU/PMUT etc.) rather than treating "no match" as an
// unknown/off state.
function extractField(text, name) {
   var m = new RegExp(name + '([0-9A-Fa-f]{16})').exec(String(text == null ? '' : text));
   return m ? m[1] : null;
}

function hdmiBtnId(idx, hdmiNum) {
   return 'tv' + idx + '_hdmi' + hdmiNum;
}

function groupAllBtnId(groupName) {
   return 'groupAll_' + sanitizeId(groupName);
}

function allPageGroupBtnId(groupName) {
   return 'allPageGroup_' + sanitizeId(groupName);
}

// --- Aggregate power state: applyTvNotify only ever knows one TV's own
//     POWR reply, but the "All <Group>"/"<Group> All"/"All On"/"All Off"
//     buttons need to know every TV's state at once to show whether a
//     whole group (or everything) is on. Each TV's last-known state is
//     kept in a persisted map (survives tab rebuilds the same way
//     ogscript.putObject/getObject is used elsewhere in this file) so the
//     aggregate can be recomputed on every single-TV update. ---

function getTvPowerMap() {
   return ogscript.getObject('tvPowerState') || {};
}

function setTvPower(idx, isOn) {
   var map = getTvPowerMap();
   map[idx] = isOn;
   ogscript.putObject('tvPowerState', map);
}

function getTvPower(idx) {
   var map = getTvPowerMap();
   return map.hasOwnProperty(idx) ? map[idx] : null;
}

function groupAllOn(groupName) {
   var tvs = tvsInGroup(groupName);
   if (tvs.length === 0) return false;
   for (var i = 0; i < tvs.length; i++) {
      if (getTvPower(tvs[i].index) !== true) return false;
   }
   return true;
}

function allTvsOn() {
   var tvs = getConfiguredTvs();
   if (tvs.length === 0) return false;
   for (var i = 0; i < tvs.length; i++) {
      if (getTvPower(tvs[i].index) !== true) return false;
   }
   return true;
}

function allTvsOff() {
   var tvs = getConfiguredTvs();
   if (tvs.length === 0) return false;
   for (var i = 0; i < tvs.length; i++) {
      if (getTvPower(tvs[i].index) !== false) return false;
   }
   return true;
}

function refreshMasterButtons() {
   var tvs = getConfiguredTvs();
   var groups = getGroups(tvs);
   for (var i = 0; i < groups.length; i++) {
      var style = groupAllOn(groups[i]) ? accentBtnStyle() : cmdBtnStyle();
      ogscript.setStyle(groupAllBtnId(groups[i]), style);
      ogscript.setStyle(allPageGroupBtnId(groups[i]), style);
   }
   ogscript.setStyle('allOnBtn', allTvsOn() ? accentBtnStyle() : cmdBtnStyle());
   ogscript.setStyle('allOffBtn', allTvsOff() ? accentBtnStyle() : cmdBtnStyle());
}

function inptPayloadToHdmi(payload) {
   if (payload === '0000000100000001') return 1;
   if (payload === '0000000100000002') return 2;
   if (payload === '0000000100000003') return 3;
   return null;
}

function applyTvNotify(idx, text) {
   var powr = extractField(text, 'POWR');
   var inpt = extractField(text, 'INPT');

   if (powr !== null) {
      var isOn = powr === '0000000000000001';
      ogscript.setStyle('tv' + idx, isOn ? accentBtnStyle() : cmdBtnStyle());
      setTvPower(idx, isOn);
      refreshMasterButtons();
   }
   if (inpt !== null) {
      var activeHdmi = inptPayloadToHdmi(inpt);
      for (var h = 1; h <= 3; h++) {
         ogscript.setStyle(hdmiBtnId(idx, h), h === activeHdmi ? accentBtnStyle() : cmdBtnStyle());
      }
   }
}

// rosstalk.sendAsBytesWithResponse turned out to only ever hand the callback
// a plain success/fail boolean (confirmed from DashBoard's own compiled
// classes - RossTalkSender's callback path only forwards its "success"
// flag to the script callback), never the actual reply bytes. It's an
// ack-only helper built for RossTalk's own protocol, not a generic
// request/response reader. Reading a real reply from an arbitrary device
// needs DashBoard's lower-level <listener> tag instead: a persistent
// client-mode TCP connection per TV, kept in a side container so it
// survives tab/UI rebuilds, sending the query on connect and reading the
// reply text directly off the message event.

function listenerIdFor(idx) {
   return 'lst' + idx;
}

function handleTvListenerEvent(idx, event, conn) {
   if (event.isConnectEvent()) {
      conn.writeString(params.getValue('sony.power.get', 0), false);
      conn.writeString(params.getValue('sony.input.get', 0), false);
   } else if (event.isMessageEvent()) {
      applyTvNotify(idx, event.getBytesAsString());
   }
}

function buildListenerXml(tv) {
   if (!tv.ip) return '';
   return '<listener id="' + listenerIdFor(tv.index) + '" connecthost="' + escapeXmlAttr(tv.ip) +
      '" connectport="' + params.getValue('sony.port', 0) + '" delimitertype="newline" autostart="true">' +
      taskTag('handleTvListenerEvent(' + tv.index + ', event, this);') +
      '</listener>';
}

// Rebuilds every TV's listener from the current config. Called whenever the
// TV roster changes; lives in its own 'listenerHost' container outside
// 'mainTabs' so ordinary tab/button rebuilds never touch it.
function rebuildListeners() {
   var tvs = getConfiguredTvs();
   var xml = '';
   for (var i = 0; i < tvs.length; i++) {
      xml += buildListenerXml(tvs[i]);
   }
   ogscript.setXML('listenerHost', xml);
}

// Forces a fresh query: a connected listener won't re-send on its own, so
// stop/start cycles the connection, which re-fires the connect event and
// re-sends the query per handleTvListenerEvent above.
function pollTv(idx) {
   var lst = ogscript.getListenerById(listenerIdFor(idx));
   if (!lst) return;
   try {
      lst.stop();
      lst.start();
   } catch (e) {
      // Best-effort refresh; a failed restart just means this TV stays at
      // its last-known state until the next poll cycle.
   }
}

function pollAllTvs() {
   var tvs = getConfiguredTvs();
   for (var i = 0; i < tvs.length; i++) pollTv(tvs[i].index);
}

// --- Dynamic UI generation. The full tab set is rebuilt from config via
//     ogscript.setXML() every time the panel loads or the config changes;
//     none of this XML is ever written back into the .grid file. ---

function buildTvBlockXml(tv, blockPheight) {
   // A self-contained nested table: one component, so N of these can sit
   // side by side in a single outer <tr> and share its width evenly via
   // weightx, however many TVs land in that row. blockPheight is the total
   // vertical budget for this block (toggle + HDMI row combined), which
   // shrinks when a group is split across a top and bottom row.
   var topH = Math.round(blockPheight * 0.58);
   var hdmiH = blockPheight - topH;
   return '<table colspan="1" fill="both" pheight="' + blockPheight + '" pwidth="150" rowspan="1" weightx="1.0" weighty="1.0">' +
      '<tr>' +
         '<button id="' + tv.btn + '" buttontype="push" colspan="3" fill="both" name="' + escapeXmlAttr(tv.label) +
         '" pheight="' + topH + '" rowspan="1" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
         taskTag('toggleTv(' + tv.index + ');') + '</button>' +
      '</tr>' +
      '<tr>' +
         '<button id="' + hdmiBtnId(tv.index, 1) + '" buttontype="push" colspan="1" fill="both" name="1" pheight="' + hdmiH + '" rowspan="1" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
         taskTag('selectHdmi(' + tv.index + ',1);') + '</button>' +
         '<button id="' + hdmiBtnId(tv.index, 2) + '" buttontype="push" colspan="1" fill="both" name="2" pheight="' + hdmiH + '" rowspan="1" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
         taskTag('selectHdmi(' + tv.index + ',2);') + '</button>' +
         '<button id="' + hdmiBtnId(tv.index, 3) + '" buttontype="push" colspan="1" fill="both" name="3" pheight="' + hdmiH + '" rowspan="1" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
         taskTag('selectHdmi(' + tv.index + ',3);') + '</button>' +
      '</tr>' +
   '</table>';
}

function buildGroupSettingsInnerXml(groupName, groupTvs) {
   var rowH = 100;

   // The Row (Top/Bottom) column used to only render once a group had 2+
   // TVs. That made the list table's column count - and so its natural
   // width - change depending on TV count, and that change was what
   // dragged the whole button column (+ Add TV / Rename Tab / Delete Tab)
   // wider along with it. Rendering the column unconditionally keeps the
   // list's structure, and therefore the whole settings row's layout,
   // identical no matter how many TVs are in the group.
   // Removing weightx (previous attempt) didn't make columns hold their
   // pwidth - it made them collapse to bare content size instead, proving
   // weightx is required alongside pwidth for a column to actually claim
   // that space in this table layout, not just optional. Since equal
   // weightx among these four columns still leaves room for redistribution
   // to drift, the header/row columns below keep pwidth+weightx (needed for
   // the inner table to stack rows automatically), but everything outside
   // this inner table - the list's box, and the three buttons next to it -
   // is now placed with plain left/top/width/height, the same absolute
   // positioning already used elsewhere in this file (rename popup,
   // Setup tab). No table-layout math is involved there at all, so nothing
   // can make it drift.
   var headerXml = '<tr>' +
      '<label colspan="1" fill="both" name="Label" pheight="' + rowH + '" pwidth="190" weightx="1.0" weighty="0.0" style="' + labelStyle() + '"/>' +
      '<label colspan="1" fill="both" name="IP Address" pheight="' + rowH + '" pwidth="190" weightx="1.0" weighty="0.0" style="' + labelStyle() + '"/>' +
      '<label colspan="1" fill="both" name="Row" pheight="' + rowH + '" pwidth="110" weightx="1.0" weighty="0.0" style="font:bold;"/>' +
      '<label colspan="1" fill="both" name="" pheight="' + rowH + '" pwidth="90" weightx="1.0" weighty="0.0" style="font:bold;"/></tr>';

   var rowsXml = '';
   for (var i = 0; i < groupTvs.length; i++) {
      var tv = groupTvs[i];
      rowsXml += '<tr>' +
         '<param colspan="1" fill="both" oid="cfg.tv.label" element="' + tv.index + '" pheight="' + rowH + '" minh="' + rowH + '" pwidth="190" weightx="1.0" weighty="0.0" style="size:18;" ' +
            'onchange="ogscript.rename(\'tv\' + this.getIndex(), this.getValueAsString());"/>' +
         '<param colspan="1" fill="both" oid="cfg.tv.ip" element="' + tv.index + '" pheight="' + rowH + '" minh="' + rowH + '" pwidth="190" weightx="1.0" weighty="0.0" style="size:18;"/>' +
         '<button buttontype="push" colspan="1" fill="both" name="' + (tv.row === 'bottom' ? 'Bottom' : 'Top') +
            '" pheight="' + rowH + '" pwidth="110" weightx="1.0" weighty="0.0" style="' + cmdBtnStyle() + '">' +
            taskTag('toggleTvRow(' + tv.index + ');') + '</button>' +
         '<button buttontype="push" colspan="1" fill="both" name="-" pheight="' + rowH + '" pwidth="90" weightx="1.0" weighty="0.0" style="' + cmdBtnStyle() + '">' +
            taskTag('removeTv(' + tv.index + ');') + '</button>' +
         '</tr>';
   }

   // The list box itself is now absolutely positioned (left/top/width/
   // height) rather than a weighted table cell, so its size can't be
   // affected by anything outside it. Its own inner <table> still needs
   // pwidth+weightx per column (above) purely to lay out Label/IP/Row/-
   // side by side and stack one <tr> per TV; scroll="vertical" kicks in
   // once that content (rowH per TV) outgrows the fixed height="168" box.
   var listContentHeight = rowH * (groupTvs.length + 1);
   var listXml = '<abs left="0" top="0" width="580" height="168" scroll="vertical">' +
      '<table bottom="0" left="0" right="0" top="0">' + headerXml + rowsXml + '</table>' +
      '</abs>';

   var btnH = 56;
   var btnW = 140;
   var controlsXml =
      '<button buttontype="push" name="+ Add TV" left="596" top="0" width="' + btnW + '" height="' + btnH + '" style="' + cmdBtnStyle() + 'size:normal;">' +
         taskTag('addTvToGroup(' + jsStr(groupName) + ');') + '</button>' +
      '<button buttontype="push" name="Rename Tab" left="596" top="' + btnH + '" width="' + btnW + '" height="' + btnH + '" style="' + cmdBtnStyle() + 'size:normal;">' +
         taskTag('openRenamePopup(' + jsStr(groupName) + ');') + '</button>' +
      '<button buttontype="push" name="Delete Tab" left="596" top="' + (btnH * 2) + '" width="' + btnW + '" height="' + btnH + '" style="' + cmdBtnStyle() + 'size:normal;">' +
         taskTag('deleteGroup(' + jsStr(groupName) + ');') + '</button>';

   return listXml + controlsXml;
}

function buildGroupSettingsXml(groupName, groupTvs) {
   return '<abs anchor="west" id="' + settingsIdFor(groupName) + '" name="Settings" style="' + pageBgStyle() + '" width="752" height="168" virtualwidth="752" virtualheight="168">' +
      buildGroupSettingsInnerXml(groupName, groupTvs) +
      '</abs>';
}

function buildGroupMainInnerXml(groupName, tvs) {
   var groupTvs = [];
   for (var i = 0; i < tvs.length; i++) { if (tvs[i].group === groupName) groupTvs.push(tvs[i]); }

   var topTvs = [];
   var bottomTvs = [];
   for (var i = 0; i < groupTvs.length; i++) {
      (groupTvs[i].row === 'bottom' ? bottomTvs : topTvs).push(groupTvs[i]);
   }
   var twoRows = bottomTvs.length > 0;
   var blockPheight = twoRows ? 82 : 168;

   var topRowXml = '';
   for (var i = 0; i < topTvs.length; i++) { topRowXml += buildTvBlockXml(topTvs[i], blockPheight); }
   var gridRowsXml = '<tr>' + topRowXml + '</tr>';
   if (twoRows) {
      var bottomRowXml = '';
      for (var j = 0; j < bottomTvs.length; j++) { bottomRowXml += buildTvBlockXml(bottomTvs[j], blockPheight); }
      gridRowsXml += '<tr>' + bottomRowXml + '</tr>';
   }

   var masterXml =
      '<table colspan="1" fill="both" pheight="170" pwidth="267" right="0" rowspan="1" weightx="0.25" weighty="1.0">' +
         '<tr>' +
            '<button id="' + groupAllBtnId(groupName) + '" buttontype="push" colspan="2" fill="both" name="' + escapeXmlAttr(groupName + ' All') + '" pheight="85" rowspan="1" weightx="1.0" weighty="1.0" style="' + (groupAllOn(groupName) ? accentBtnStyle() : cmdBtnStyle()) + '">' +
               taskTag('toggleGroup(' + jsStr(groupName) + ');') + '</button>' +
         '</tr>' +
         '<tr>' +
            '<button buttontype="push" colspan="1" fill="both" name="' + escapeXmlAttr(groupName + ' On') + '" pheight="85" rowspan="1" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
               taskTag('powerOnGroup(' + jsStr(groupName) + ');') + '</button>' +
            '<button buttontype="push" colspan="1" fill="both" name="' + escapeXmlAttr(groupName + ' Off') + '" pheight="85" rowspan="1" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
               taskTag('powerOffGroup(' + jsStr(groupName) + ');') + '</button>' +
         '</tr>' +
      '</table>';

   return '<table bottom="0" left="0" right="0" top="0">' +
         '<tr>' +
            '<table colspan="1" fill="both" pheight="170" pwidth="994" rowspan="1" weightx="1.0" weighty="1.0">' +
               gridRowsXml +
            '</table>' +
            masterXml +
         '</tr>' +
      '</table>';
}

function buildGroupPageXml(groupName, tvs) {
   var groupTvs = [];
   for (var i = 0; i < tvs.length; i++) { if (tvs[i].group === groupName) groupTvs.push(tvs[i]); }

   return '<abs id="' + tabIdFor(groupName) + '" name="' + escapeXmlAttr(groupName) + '" style="' + pageBgStyle() + '" virtualheight="170" virtualwidth="1302">' +
      '<drawer bottom="0" left="0" right="0" tabfill="both" top="0">' +
      buildGroupSettingsXml(groupName, groupTvs) +
      '<abs id="' + mainIdFor(groupName) + '" style="' + pageBgStyle() + '" height="168" virtualheight="170" virtualwidth="1262" width="1235">' +
      buildGroupMainInnerXml(groupName, tvs) +
      '</abs>' +
      '</drawer>' +
      '</abs>';
}

// Targeted update used by in-tab edits (add/remove TV, move row) so the
// drawer's own open/closed state survives — only the Settings panel and the
// TV grid content are replaced, never the <drawer> element itself.
function updateGroupTab(groupName) {
   var tvs = getConfiguredTvs();
   var groupTvs = [];
   for (var i = 0; i < tvs.length; i++) { if (tvs[i].group === groupName) groupTvs.push(tvs[i]); }
   ogscript.setXML(settingsIdFor(groupName), buildGroupSettingsInnerXml(groupName, groupTvs));
   ogscript.setXML(mainIdFor(groupName), buildGroupMainInnerXml(groupName, tvs));
   rebuildListeners();
   ogscript.asyncExec(pollAllTvs, 300);
}

function buildAllPageXml(tvs, groups) {
   var xml = '<abs name="All" style="' + pageBgStyle() + '" virtualheight="170" virtualwidth="1302"><table bottom="0" left="0" right="0" top="0"><tr>';
   for (var i = 0; i < groups.length; i++) {
      xml += '<button id="' + allPageGroupBtnId(groups[i]) + '" buttontype="push" colspan="2" fill="both" name="' + escapeXmlAttr('All ' + groups[i]) + '" pheight="85" weightx="1.0" weighty="1.0" style="' + (groupAllOn(groups[i]) ? accentBtnStyle() : cmdBtnStyle()) + '">' +
         taskTag('toggleGroup(' + jsStr(groups[i]) + ');') + '</button>';
   }
   xml += '<button buttontype="push" colspan="2" fill="both" name="Toggle All" pheight="85" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
      taskTag('toggleAll();') + '</button>';
   xml += '</tr><tr>';
   for (var j = 0; j < groups.length; j++) {
      xml += '<button buttontype="push" fill="both" name="' + escapeXmlAttr(groups[j] + ' On') + '" pheight="85" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
         taskTag('powerOnGroup(' + jsStr(groups[j]) + ');') + '</button>';
      xml += '<button buttontype="push" fill="both" name="' + escapeXmlAttr(groups[j] + ' Off') + '" pheight="85" weightx="1.0" weighty="1.0" style="' + cmdBtnStyle() + '">' +
         taskTag('powerOffGroup(' + jsStr(groups[j]) + ');') + '</button>';
   }
   xml += '<button id="allOnBtn" buttontype="push" fill="both" name="All On" pheight="85" weightx="1.0" weighty="1.0" style="' + (allTvsOn() ? accentBtnStyle() : cmdBtnStyle()) + '">' +
      taskTag('powerOnAll();') + '</button>';
   xml += '<button id="allOffBtn" buttontype="push" fill="both" name="All Off" pheight="85" weightx="1.0" weighty="1.0" style="' + (allTvsOff() ? accentBtnStyle() : cmdBtnStyle()) + '">' +
      taskTag('powerOffAll();') + '</button>';
   xml += '</tr></table></abs>';
   return xml;
}

// Absolutely positioned (left/top/width), not a weighted table - same
// reasoning as the group Settings drawer: fixed pixel placement can't drift
// the way table+weightx cells did, and adding the "create tab" row here
// only needs to not collide with the existing theme fields, not coexist in
// their table's column/weight math.
function buildThemeFieldXml(labelText, oid, x, y, w) {
   return '<label left="' + x + '" top="' + y + '" width="' + w + '" height="20" name="' + escapeXmlAttr(labelText) + '" style="' + labelStyle() + '"/>' +
      '<param oid="' + oid + '" element="0" left="' + x + '" top="' + (y + 22) + '" width="' + w + '" height="34" minh="34" style="size:normal;" ' +
         'onchange="rebuildFromConfig(); stayOnSetupTab();"/>';
}

function buildSetupPageXml() {
   var themeFields = [
      ['Background', 'cfg.theme.bg'],
      ['Card Bg', 'cfg.theme.card'],
      ['Button', 'cfg.theme.button'],
      ['Button Text', 'cfg.theme.buttontext'],
      ['Text', 'cfg.theme.text'],
      ['Accent', 'cfg.theme.accent'],
      ['Accent Text', 'cfg.theme.accenttext']
   ];
   var fieldW = 140;
   var step = 148;
   var fieldsXml = '';
   for (var i = 0; i < themeFields.length; i++) {
      fieldsXml += buildThemeFieldXml(themeFields[i][0], themeFields[i][1], i * step, 0, fieldW);
   }
   fieldsXml += buildThemeFieldXml('Logo URL', 'cfg.theme.logo', themeFields.length * step, 0, fieldW);

   // "+" used to be its own tab; folding tab creation in here removes that
   // extra tab and keeps every setup-style control (theme + new tabs) in
   // one place.
   var newTabXml =
      '<label left="0" top="70" width="260" height="18" name="New Tab Name" style="' + labelStyle() + '"/>' +
      '<param oid="cfg.newtab.name" left="0" top="90" width="260" height="34" minh="34" style="size:normal;"/>' +
      '<button buttontype="push" name="Create Tab" left="270" top="90" width="140" height="34" style="' + accentBtnStyle() + '">' +
      taskTag('createTab();') + '</button>';

   var applyXml =
      '<button buttontype="push" name="Apply Theme" left="' + ((themeFields.length + 1) * step) + '" top="22" width="110" height="34" style="' + accentBtnStyle() + '">' +
      taskTag('rebuildFromConfig(); stayOnSetupTab();') + '</button>';

   return '<abs id="setupTab" name="Setup" style="' + pageBgStyle() + '" virtualheight="170" virtualwidth="1302">' +
      fieldsXml + newTabXml + applyXml +
      '</abs>';
}

function buildRenamePopupInnerXml() {
   return '<abs style="' + pageBgStyle() + '" left="0" top="0" width="300" height="46">' +
      '<param oid="cfg.rename.input" element="0" left="6" top="4" width="190" height="38" minh="38" style="size:normal;"/>' +
      '<button buttontype="push" name="Rename" style="' + accentBtnStyle() + '" left="200" top="4" width="94" height="38">' +
      taskTag('renameGroup();') +
      '</button>' +
      '</abs>';
}

function rebuildFromConfig(reopenGroup) {
   var tvs = getConfiguredTvs();
   var groups = getGroups(tvs);
   var xml = buildAllPageXml(tvs, groups);
   for (var i = 0; i < groups.length; i++) {
      xml += buildGroupPageXml(groups[i], tvs);
   }
   xml += buildSetupPageXml();
   ogscript.setXML('mainTabs', xml);
   ogscript.setXML('renamePopupInner', buildRenamePopupInnerXml());
   rebuildLogo();
   rebuildListeners();
   ogscript.asyncExec(pollAllTvs, 500);
   if (reopenGroup) {
      ogscript.asyncExec(function() {
         ogscript.reveal(tabIdFor(reopenGroup) + ',' + settingsIdFor(reopenGroup));
      }, 500);
   }
}
      ]]></api>
        <ogscript handles="onload">rebuildFromConfig(); ogscript.installTimer('tvPowerPoll', true, 8000, 10000, pollAllTvs);</ogscript>
    </meta>
    <tab bottom="0" id="mainTabs" left="0" right="0" style="bg#000000;fg#F2F2F2;" tabposition="south" top="0"/>
    <abs height="1" id="listenerHost" left="0" top="0" visible="false" width="1"/>
    <abs height="26" id="logoHost" left="1228" top="174" visible="true" width="64"/>
    <popup height="1" id="renamePopup" left="400" name="Rename" top="10" visible="false" width="1">
        <abs height="46" id="renamePopupInner" width="300"/>
    </popup>
</abs>
